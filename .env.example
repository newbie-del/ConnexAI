# Copy to .env and fill in before deploying.
# Every variable below is read somewhere in src/ — grep the name to find its use.

# --- App / auth -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LiveKit: voice/video calls + AI agent audio ----------------------------
# https://cloud.livekit.io — project settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: egress recordings on S3-compatible storage.
# If unset, recording is skipped with a console warning instead of failing.
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_REGION=

# Public base URL recordings are served from (bucket public endpoint or CDN).
RECORDING_PUBLIC_BASE_URL=

# --- Google Gemini: meeting summaries + chat generation ---------------------
# Free key (no card): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional overrides; defaults live in src/lib/gemini.ts
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite

# --- Stream Chat: post-meeting chat ----------------------------------------
NEXT_PUBLIC_STREAM_CHAT_API_KEY=
STREAM_CHAT_SECRET_KEY=

# --- Stream Video + OpenAI Realtime ---------------------------------------
# Still used by the legacy /api/webhook agent-connect path.
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
STREAM_VIDEO_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# --- Inngest: background jobs ---------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Polar: premium subscriptions -----------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox

# --- Python agent worker handshake ----------------------------------------
# Must match CONNEXAI_INGEST_SECRET in agent-worker/.env, which posts
# transcripts to /api/livekit/transcript.
CONNEXAI_INGEST_SECRET=
