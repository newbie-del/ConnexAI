# LiveKit server credentials (from LiveKit Cloud project settings, or your self-hosted server).
# These MUST match the web app's LiveKit project, or dispatches never arrive.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Gemini API key — FREE from https://aistudio.google.com/apikey (no credit card).
GOOGLE_API_KEY=

# Where to POST the transcript when a meeting ends. Use the deployed app URL.
CONNEXAI_INGEST_URL=https://your-app.vercel.app/api/livekit/transcript
# Shared secret — must match CONNEXAI_INGEST_SECRET in the web app, or posts 401.
CONNEXAI_INGEST_SECRET=

# Optional tuning.
# GEMINI_VOICE=
# GEMINI_LANGUAGE=
# GEMINI_MAX_OUTPUT_TOKENS=
# FORCE_IPV4=1
